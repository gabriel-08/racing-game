        // WEB AUDIO SYNTHESIZER ENGINES
        class SoundEngine {
            constructor() {
                this.ctx = null;
                this.engineOsc = null;
                this.engineGain = null;
                this.nitroGain = null;
                this.skidGain = null;
                this.skidBufferNode = null;
            }

            init() {
                if (!this.ctx) {
                    const AudioCtx = window.AudioContext || window.webkitAudioContext;
                    if (AudioCtx) {
                        this.ctx = new AudioCtx();
                        this.setupSynthesizers();
                    }
                }
                if (this.ctx && this.ctx.state === 'suspended') {
                    this.ctx.resume();
                }
            }

            setupSynthesizers() {
                // Engine Sound Oscillator
                this.engineOsc = this.ctx.createOscillator();
                this.engineOsc.type = 'sawtooth';
                this.engineOsc.frequency.setValueAtTime(55, this.ctx.currentTime);

                const engineFilter = this.ctx.createBiquadFilter();
                engineFilter.type = 'lowpass';
                engineFilter.frequency.setValueAtTime(400, this.ctx.currentTime);

                this.engineGain = this.ctx.createGain();
                this.engineGain.gain.setValueAtTime(0.05, this.ctx.currentTime);

                this.engineOsc.connect(engineFilter);
                engineFilter.connect(this.engineGain);
                this.engineGain.connect(this.ctx.destination);
                this.engineOsc.start();

                // Nitro Noise Generator
                const bufferSize = this.ctx.sampleRate * 2;
                const noiseBuffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
                const output = noiseBuffer.getChannelData(0);
                for (let i = 0; i < bufferSize; i++) {
                    output[i] = Math.random() * 2 - 1;
                }

                const nitroNoise = this.ctx.createBufferSource();
                nitroNoise.buffer = noiseBuffer;
                nitroNoise.loop = true;

                const nitroFilter = this.ctx.createBiquadFilter();
                nitroFilter.type = 'bandpass';
                nitroFilter.frequency.setValueAtTime(1200, this.ctx.currentTime);

                this.nitroGain = this.ctx.createGain();
                this.nitroGain.gain.setValueAtTime(0.0, this.ctx.currentTime);

                nitroNoise.connect(nitroFilter);
                nitroFilter.connect(this.nitroGain);
                this.nitroGain.connect(this.ctx.destination);
                nitroNoise.start();

                // Drift Skid Noise
                const skidNoise = this.ctx.createBufferSource();
                skidNoise.buffer = noiseBuffer;
                skidNoise.loop = true;

                const skidFilter = this.ctx.createBiquadFilter();
                skidFilter.type = 'highpass';
                skidFilter.frequency.setValueAtTime(2000, this.ctx.currentTime);

                this.skidGain = this.ctx.createGain();
                this.skidGain.gain.setValueAtTime(0.0, this.ctx.currentTime);

                skidNoise.connect(skidFilter);
                skidFilter.connect(this.skidGain);
                this.skidGain.connect(this.ctx.destination);
                skidNoise.start();
            }

            updateEngine(speedRatio, isRacing) {
                if (!this.ctx || !this.engineOsc) return;
                const now = this.ctx.currentTime;
                if (!isRacing) {
                    this.engineGain.gain.setTargetAtTime(0.02, now, 0.1);
                    this.engineOsc.frequency.setTargetAtTime(45, now, 0.1);
                    return;
                }
                const freq = 50 + speedRatio * 220;
                this.engineOsc.frequency.setTargetAtTime(freq, now, 0.05);
                this.engineGain.gain.setTargetAtTime(0.08 + speedRatio * 0.08, now, 0.05);
            }

            setNitro(active) {
                if (!this.ctx || !this.nitroGain) return;
                this.nitroGain.gain.setTargetAtTime(active ? 0.25 : 0.0, this.ctx.currentTime, 0.05);
            }

            setDrift(active) {
                if (!this.ctx || !this.skidGain) return;
                this.skidGain.gain.setTargetAtTime(active ? 0.15 : 0.0, this.ctx.currentTime, 0.05);
            }

            playImpact(intensity = 1.0) {
                if (!this.ctx) return;
                try {
                    const now = this.ctx.currentTime;
                    const bufferSize = this.ctx.sampleRate * 0.2;
                    const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
                    const data = buffer.getChannelData(0);
                    for (let i = 0; i < bufferSize; i++) {
                        data[i] = (Math.random() * 2 - 1) * Math.exp(-i / (bufferSize * 0.3));
                    }

                    const noise = this.ctx.createBufferSource();
                    noise.buffer = buffer;

                    const filter = this.ctx.createBiquadFilter();
                    filter.type = 'lowpass';
                    filter.frequency.setValueAtTime(700 + intensity * 600, now);

                    const gain = this.ctx.createGain();
                    gain.gain.setValueAtTime(Math.min(intensity * 0.5, 0.8), now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.2);

                    noise.connect(filter);
                    filter.connect(gain);
                    gain.connect(this.ctx.destination);

                    noise.start(now);
                } catch(e) {}
            }
        }

        // INPUT CONTROLLER
        class InputHandler {
            constructor() {
                this.keys = { forward: false, backward: false, left: false, right: false, handbrake: false, nitro: false };
                this.onResetPress = null;
                this.onCameraPress = null;
                this.onPausePress = null;

                window.addEventListener('keydown', (e) => this.handleKey(e, true));
                window.addEventListener('keyup', (e) => this.handleKey(e, false));
                this.setupTouchControls();
            }

            handleKey(e, isDown) {
                switch(e.code) {
                    case 'KeyW': case 'ArrowUp': this.keys.forward = isDown; break;
                    case 'KeyS': case 'ArrowDown': this.keys.backward = isDown; break;
                    case 'KeyA': case 'ArrowLeft': this.keys.left = isDown; break;
                    case 'KeyD': case 'ArrowRight': this.keys.right = isDown; break;
                    case 'Space': this.keys.handbrake = isDown; break;
                    case 'ShiftLeft': case 'ShiftRight': this.keys.nitro = isDown; break;
                    case 'KeyR':
                        if (isDown && this.onResetPress) this.onResetPress();
                        break;
                    case 'KeyC':
                        if (isDown && this.onCameraPress) this.onCameraPress();
                        break;
                    case 'Escape':
                        if (isDown && this.onPausePress) this.onPausePress();
                        break;
                }
            }

            setupTouchControls() {
                const isTouchDevice = 'ontouchstart' in window || navigator.maxTouchPoints > 0;
                if (!isTouchDevice) return;

                const touchOverlay = document.getElementById('touch-controls');
                if (touchOverlay) {
                    touchOverlay.classList.remove('hidden');
                    touchOverlay.classList.add('flex');
                }

                const bindTouch = (id, key) => {
                    const btn = document.getElementById(id);
                    if (!btn) return;
                    btn.addEventListener('touchstart', (e) => { e.preventDefault(); this.keys[key] = true; });
                    btn.addEventListener('touchend', (e) => { e.preventDefault(); this.keys[key] = false; });
                };

                bindTouch('btn-left', 'left');
                bindTouch('btn-right', 'right');
                bindTouch('btn-gas', 'forward');
                bindTouch('btn-brake', 'backward');
                bindTouch('btn-nitro', 'nitro');
            }
        }

        // TIRE SMOKE, SPARKS, NITRO FLAMES & WEATHER PARTICLES
        class ParticleSystem {
            constructor(scene) {
                this.scene = scene;
                this.particles = [];
                this.weatherParticles = [];

                this.smokeGeo = new THREE.SphereGeometry(0.25, 6, 6);
                this.smokeMat = new THREE.MeshBasicMaterial({ color: 0xcccccc, transparent: true, opacity: 0.5 });

                this.sparkGeo = new THREE.BoxGeometry(0.12, 0.12, 0.12);
                this.sparkMat = new THREE.MeshBasicMaterial({ color: 0xffaa00 });

                this.nitroGeo = new THREE.SphereGeometry(0.2, 6, 6);
                this.nitroMat = new THREE.MeshBasicMaterial({ color: 0x00ffff, transparent: true, opacity: 0.8 });

                // Weather Geo
                this.rainGeo = new THREE.CylinderGeometry(0.02, 0.02, 1.2);
                this.rainMat = new THREE.MeshBasicMaterial({ color: 0x38bdf8, transparent: true, opacity: 0.6 });

                this.snowGeo = new THREE.SphereGeometry(0.08, 4, 4);
                this.snowMat = new THREE.MeshBasicMaterial({ color: 0xffffff, transparent: true, opacity: 0.8 });
            }

            emitSmoke(pos) {
                const p = new THREE.Mesh(this.smokeGeo, this.smokeMat.clone());
                p.position.copy(pos);
                p.position.x += (Math.random() - 0.5) * 0.2;
                p.position.z += (Math.random() - 0.5) * 0.2;
                this.scene.add(p);

                this.particles.push({
                    mesh: p,
                    life: 0.5,
                    maxLife: 0.5,
                    vel: new THREE.Vector3((Math.random() - 0.5) * 0.4, Math.random() * 0.8 + 0.3, (Math.random() - 0.5) * 0.4)
                });
            }

            emitNitroFlame(pos, heading) {
                const p = new THREE.Mesh(this.nitroGeo, this.nitroMat.clone());
                p.position.copy(pos);
                this.scene.add(p);

                const backVec = new THREE.Vector3(0, 0, 1).applyAxisAngle(new THREE.Vector3(0, 1, 0), heading).multiplyScalar(15);
                this.particles.push({
                    mesh: p,
                    life: 0.25,
                    maxLife: 0.25,
                    vel: backVec.add(new THREE.Vector3((Math.random() - 0.5) * 2, (Math.random() - 0.5) * 2, (Math.random() - 0.5) * 2))
                });
            }

            emitSparks(pos, count = 12) {
                for (let i = 0; i < count; i++) {
                    const spark = new THREE.Mesh(this.sparkGeo, this.sparkMat.clone());
                    spark.position.copy(pos);
                    this.scene.add(spark);

                    const vel = new THREE.Vector3(
                        (Math.random() - 0.5) * 16,
                        Math.random() * 8 + 3,
                        (Math.random() - 0.5) * 16
                    );

                    this.particles.push({
                        mesh: spark,
                        life: 0.35,
                        maxLife: 0.35,
                        vel: vel
                    });
                }
            }

            setupWeather(type, carPos) {
                this.clearWeather();
                if (type === 'none') return;

                const count = type === 'rain' ? 300 : 250;
                const geo = type === 'rain' ? this.rainGeo : this.snowGeo;
                const mat = type === 'rain' ? this.rainMat : this.snowMat;

                for (let i = 0; i < count; i++) {
                    const mesh = new THREE.Mesh(geo, mat);
                    mesh.position.set(
                        carPos.x + (Math.random() - 0.5) * 120,
                        Math.random() * 40 + 2,
                        carPos.z + (Math.random() - 0.5) * 120
                    );
                    this.scene.add(mesh);
                    this.weatherParticles.push({
                        mesh: mesh,
                        type: type,
                        speed: type === 'rain' ? Math.random() * 40 + 50 : Math.random() * 8 + 6
                    });
                }
            }

            clearWeather() {
                this.weatherParticles.forEach(wp => {
                    this.scene.remove(wp.mesh);
                });
                this.weatherParticles = [];
            }

            update(dt, carPos) {
                // Update standard particles
                for (let i = this.particles.length - 1; i >= 0; i--) {
                    const p = this.particles[i];
                    p.life -= dt;
                    if (p.life <= 0) {
                        this.scene.remove(p.mesh);
                        p.mesh.geometry.dispose();
                        p.mesh.material.dispose();
                        this.particles.splice(i, 1);
                    } else {
                        p.mesh.position.addScaledVector(p.vel, dt);
                        if (p.mesh.material.transparent) {
                            p.mesh.material.opacity = (p.life / p.maxLife) * 0.7;
                        }
                        p.mesh.scale.addScalar(dt * 0.6);
                    }
                }

                // Update weather particles relative to car center
                this.weatherParticles.forEach(wp => {
                    wp.mesh.position.y -= wp.speed * dt;
                    if (wp.type === 'snow') {
                        wp.mesh.position.x += Math.sin(wp.mesh.position.y) * 0.1;
                    }
                    if (wp.mesh.position.y < 0) {
                        wp.mesh.position.y = 40;
                        wp.mesh.position.x = carPos.x + (Math.random() - 0.5) * 120;
                        wp.mesh.position.z = carPos.z + (Math.random() - 0.5) * 120;
                    }
                });
            }
        }

        // TIRE SKID MARK DECAL GENERATOR
        class SkidMarkManager {
            constructor(scene) {
                this.scene = scene;
                this.skidLines = [];
                this.material = new THREE.MeshBasicMaterial({ color: 0x111111, side: THREE.DoubleSide, transparent: true, opacity: 0.6 });
            }

            addMark(p1, p2) {
                const geom = new THREE.BufferGeometry();
                const vertices = new Float32Array([
                    p1.x - 0.25, 0.06, p1.z,
                    p1.x + 0.25, 0.06, p1.z,
                    p2.x - 0.25, 0.06, p2.z,
                    p2.x + 0.25, 0.06, p2.z
                ]);
                geom.setAttribute('position', new THREE.BufferAttribute(vertices, 3));
                geom.setIndex([0, 1, 2, 1, 3, 2]);

                const mesh = new THREE.Mesh(geom, this.material);
                this.scene.add(mesh);
                this.skidLines.push({ mesh: mesh, life: 6.0 });

                // Limit maximum active skid mark segments to retain 60FPS
                if (this.skidLines.length > 250) {
                    const old = this.skidLines.shift();
                    this.scene.remove(old.mesh);
                    old.mesh.geometry.dispose();
                }
            }

            clear() {
                this.skidLines.forEach(s => {
                    this.scene.remove(s.mesh);
                    s.mesh.geometry.dispose();
                });
                this.skidLines = [];
            }
        }

        // PROCEDURAL TRACK & ENVIRONMENT BUILDER
        class TrackBuilder {
            constructor(scene) {
                this.scene = scene;
                this.checkpoints = [];
                this.barriers = [];
                this.levelGroup = new THREE.Group();
                this.scene.add(this.levelGroup);
            }

            clear() {
                while(this.levelGroup.children.length > 0) {
                    const obj = this.levelGroup.children[0];
                    this.levelGroup.remove(obj);
                    if (obj.geometry) obj.geometry.dispose();
                }
                this.checkpoints = [];
                this.barriers = [];
            }

            build(config) {
                this.clear();
                this.config = config;
                this.curve = new THREE.CatmullRomCurve3(config.waypoints, true, 'centripetal', 0.5);
                this.trackWidth = 16;

                // Ground Plane
                const groundGeo = new THREE.PlaneGeometry(2000, 2000);
                const groundMat = new THREE.MeshStandardMaterial({ color: config.groundColor, roughness: 0.9 });
                const ground = new THREE.Mesh(groundGeo, groundMat);
                ground.rotation.x = -Math.PI / 2;
                ground.receiveShadow = true;
                this.levelGroup.add(ground);

                // Asphalt Ribbon Mesh
                const sampleCount = Math.max(360, config.waypoints.length * 30);
                const points = this.curve.getSpacedPoints(sampleCount);
                const trackGeo = new THREE.BufferGeometry();
                const vertices = [];
                const uvs = [];
                const indices = [];

                for (let i = 0; i < points.length; i++) {
                    const pt = points[i];
                    const tangent = this.curve.getTangentAt(i / points.length);
                    const normal = new THREE.Vector3(-tangent.z, 0, tangent.x).normalize();

                    const left = pt.clone().add(normal.clone().multiplyScalar(this.trackWidth / 2));
                    const right = pt.clone().add(normal.clone().multiplyScalar(-this.trackWidth / 2));

                    vertices.push(left.x, left.y + 0.05, left.z);
                    vertices.push(right.x, right.y + 0.05, right.z);

                    uvs.push(0, i / 10);
                    uvs.push(1, i / 10);

                    if (i < points.length - 1) {
                        const n = i * 2;
                        indices.push(n, n + 1, n + 2);
                        indices.push(n + 1, n + 3, n + 2);
                    }
                }

                trackGeo.setAttribute('position', new THREE.Float32BufferAttribute(vertices, 3));
                trackGeo.setAttribute('uv', new THREE.Float32BufferAttribute(uvs, 2));
                trackGeo.setIndex(indices);
                trackGeo.computeVertexNormals();

                const trackMat = new THREE.MeshStandardMaterial({ color: config.trackColor, roughness: 0.35, side: THREE.DoubleSide });
                const trackMesh = new THREE.Mesh(trackGeo, trackMat);
                trackMesh.receiveShadow = true;
                this.levelGroup.add(trackMesh);

                // Start / Finish Line Grid
                const startPt = points[0];
                const startTangent = this.curve.getTangentAt(0);
                const gridGeo = new THREE.PlaneGeometry(this.trackWidth, 3);
                const gridMat = new THREE.MeshBasicMaterial({ color: 0xffffff, side: THREE.DoubleSide });
                const finishGrid = new THREE.Mesh(gridGeo, gridMat);
                finishGrid.position.copy(startPt);
                finishGrid.position.y += 0.08;
                finishGrid.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), startTangent);
                finishGrid.rotation.x = Math.PI / 2;
                this.levelGroup.add(finishGrid);

                // Curbs, Barriers, and Roadside Props
                this.buildPropsAndBarriers(points, config);
                this.buildCheckpoints();

                return this.curve;
            }

            buildPropsAndBarriers(points, config) {
                const curbGeo = new THREE.BoxGeometry(0.8, 0.25, 1.4);
                const matColor1 = new THREE.MeshStandardMaterial({ color: config.curbColors[0] });
                const matColor2 = new THREE.MeshStandardMaterial({ color: config.curbColors[1] });

                const railMat = new THREE.MeshStandardMaterial({ color: config.props === 'cyber' ? 0x00f0ff : 0x94a3b8, metalness: 0.8, roughness: 0.2 });
                const postMat = new THREE.MeshStandardMaterial({ color: 0x475569 });
                const postGeo = new THREE.CylinderGeometry(0.15, 0.15, 1.2, 8);

                const leftBarrierPts = [];
                const rightBarrierPts = [];

                for (let i = 0; i < points.length; i += 2) {
                    const pt = points[i];
                    const tangent = this.curve.getTangentAt(i / points.length);
                    const normal = new THREE.Vector3(-tangent.z, 0, tangent.x).normalize();

                    const mat = (i / 2) % 2 === 0 ? matColor1 : matColor2;

                    // Curbs
                    const leftCurbPos = pt.clone().add(normal.clone().multiplyScalar(this.trackWidth / 2 + 0.4));
                    const rightCurbPos = pt.clone().add(normal.clone().multiplyScalar(-this.trackWidth / 2 - 0.4));

                    const leftCurb = new THREE.Mesh(curbGeo, mat);
                    leftCurb.position.copy(leftCurbPos);
                    leftCurb.quaternion.setFromUnitVectors(new THREE.Vector3(0, 0, 1), tangent);
                    this.levelGroup.add(leftCurb);

                    const rightCurb = new THREE.Mesh(curbGeo, mat);
                    rightCurb.position.copy(rightCurbPos);
                    rightCurb.quaternion.setFromUnitVectors(new THREE.Vector3(0, 0, 1), tangent);
                    this.levelGroup.add(rightCurb);

                    // Guardrail Barrier Positions
                    const leftRailPos = pt.clone().add(normal.clone().multiplyScalar(this.trackWidth / 2 + 1.2));
                    const rightRailPos = pt.clone().add(normal.clone().multiplyScalar(-this.trackWidth / 2 - 1.2));

                    leftBarrierPts.push(leftRailPos);
                    rightBarrierPts.push(rightRailPos);

                    if (i % 4 === 0) {
                        const postL = new THREE.Mesh(postGeo, postMat);
                        postL.position.copy(leftRailPos); postL.position.y += 0.6;
                        const postR = new THREE.Mesh(postGeo, postMat);
                        postR.position.copy(rightRailPos); postR.position.y += 0.6;
                        this.levelGroup.add(postL, postR);
                    }

                    // Roadside Environment Props
                    if (i % 8 === 0) {
                        const side = (i / 8) % 2 === 0 ? 1 : -1;
                        const propPos = pt.clone().add(normal.clone().multiplyScalar(side * (this.trackWidth / 2 + 9 + Math.random() * 6)));
                        this.spawnEnvironmentProp(config.props, propPos);
                    }
                }

                this.createGuardrailBeams(leftBarrierPts, railMat);
                this.createGuardrailBeams(rightBarrierPts, railMat);
            }

            spawnEnvironmentProp(type, pos) {
                const propGroup = new THREE.Group();

                if (type === 'trees') {
                    const trunkGeo = new THREE.CylinderGeometry(0.4, 0.4, 2);
                    const trunkMat = new THREE.MeshStandardMaterial({ color: 0x451a03 });
                    const treeGeo = new THREE.ConeGeometry(2.2, 6, 5);
                    const treeMat = new THREE.MeshStandardMaterial({ color: 0x064e3b, roughness: 0.8 });

                    const trunk = new THREE.Mesh(trunkGeo, trunkMat); trunk.position.y = 1;
                    const leaves = new THREE.Mesh(treeGeo, treeMat); leaves.position.y = 4;
                    propGroup.add(trunk, leaves);
                } else if (type === 'cactuses') {
                    const cacMat = new THREE.MeshStandardMaterial({ color: 0x15803d, roughness: 0.7 });
                    const bodyGeo = new THREE.CylinderGeometry(0.35, 0.35, 4, 8);
                    const mainBody = new THREE.Mesh(bodyGeo, cacMat); mainBody.position.y = 2;
                    const armGeo = new THREE.CylinderGeometry(0.25, 0.25, 1.8, 8);
                    const arm1 = new THREE.Mesh(armGeo, cacMat); arm1.rotation.z = Math.PI/2; arm1.position.set(0.8, 2.5, 0);
                    propGroup.add(mainBody, arm1);
                } else if (type === 'cyber') {
                    const pillarGeo = new THREE.BoxGeometry(1.2, 12, 1.2);
                    const pillarMat = new THREE.MeshStandardMaterial({ color: 0x020617, metalness: 0.9, roughness: 0.1 });
                    const lightMat = new THREE.MeshBasicMaterial({ color: 0x00f0ff });
                    const pillar = new THREE.Mesh(pillarGeo, pillarMat); pillar.position.y = 6;
                    const lightStrip = new THREE.Mesh(new THREE.BoxGeometry(1.3, 10, 0.2), lightMat); lightStrip.position.set(0, 6, 0.6);
                    propGroup.add(pillar, lightStrip);
                } else if (type === 'industrial') {
                    const stackGeo = new THREE.CylinderGeometry(0.8, 1.0, 8, 8);
                    const stackMat = new THREE.MeshStandardMaterial({ color: 0x3f3f46, metalness: 0.7 });
                    const stack = new THREE.Mesh(stackGeo, stackMat); stack.position.y = 4;
                    propGroup.add(stack);
                }

                propGroup.position.copy(pos);
                this.levelGroup.add(propGroup);
            }

            createGuardrailBeams(pts, mat) {
                for (let i = 0; i < pts.length - 1; i++) {
                    const p1 = pts[i];
                    const p2 = pts[i + 1];

                    const dist = p1.distanceTo(p2);
                    const beam = new THREE.Mesh(new THREE.BoxGeometry(0.25, 0.5, dist), mat);

                    const mid = p1.clone().add(p2).multiplyScalar(0.5);
                    mid.y += 0.7;
                    beam.position.copy(mid);

                    const dir = p2.clone().sub(p1).normalize();
                    beam.quaternion.setFromUnitVectors(new THREE.Vector3(0, 0, 1), dir);

                    this.levelGroup.add(beam);
                    this.barriers.push({ p1: p1.clone(), p2: p2.clone(), normal: new THREE.Vector3(-dir.z, 0, dir.x).normalize() });
                }
            }

            buildCheckpoints() {
                const count = Math.max(5, Math.floor(this.config.waypoints.length / 2));
                for (let i = 0; i < count; i++) {
                    const pos = this.curve.getPointAt(i / count);
                    this.checkpoints.push({ index: i, position: pos, radius: this.trackWidth * 1.3 });
                }
            }
        }

        // SPORTS CAR & ARCADE NITRO / DRIFT PHYSICS CONTROLLER
        class SportsCar {
            constructor(scene) {
                this.scene = scene;
                this.wheelGroup = [];
                this.wheelsMesh = [];
                this.carConfig = CAR_CONFIGS[0];

                this.position = new THREE.Vector3(0, 0.4, 0);
                this.velocity = new THREE.Vector3(0, 0, 0);
                this.heading = 0;
                this.speed = 0;
                this.steerAngle = 0;

                this.nitroAmount = 100.0;
                this.isNitroActive = false;
                this.isDrifting = false;

                this.radius = 1.3;
                this.lastDriftPosLeft = null;
                this.lastDriftPosRight = null;

                this.mesh = new THREE.Group();
                this.scene.add(this.mesh);
            }

            setCarConfig(config) {
                this.carConfig = config;
                this.buildCarMesh();
            }

            buildCarMesh() {
                // Clear existing mesh
                while(this.mesh.children.length > 0) {
                    const obj = this.mesh.children[0];
                    this.mesh.remove(obj);
                    if (obj.geometry) obj.geometry.dispose();
                }

                this.wheelGroup = [];
                this.wheelsMesh = [];

                const cfg = this.carConfig;

                // Chassis Body
                const bodyGeo = new THREE.BoxGeometry(2.2, 0.7, 4.4);
                const bodyMat = new THREE.MeshStandardMaterial({ color: cfg.color, metalness: 0.75, roughness: 0.2 });
                const bodyMesh = new THREE.Mesh(bodyGeo, bodyMat);
                bodyMesh.position.y = 0.5;
                bodyMesh.castShadow = true;
                this.mesh.add(bodyMesh);

                // Cabin Windshield
                const cabinGeo = new THREE.BoxGeometry(1.6, 0.65, 2.0);
                const cabinMat = new THREE.MeshStandardMaterial({ color: 0x090d16, roughness: 0.1 });
                const cabinMesh = new THREE.Mesh(cabinGeo, cabinMat);
                cabinMesh.position.set(0, 1.05, -0.2);
                cabinMesh.castShadow = true;
                this.mesh.add(cabinMesh);

                // Spoiler
                const spoilerWingGeo = new THREE.BoxGeometry(2.4, 0.1, 0.6);
                const spoilerMat = new THREE.MeshStandardMaterial({ color: cfg.accentColor });
                const spoilerWing = new THREE.Mesh(spoilerWingGeo, spoilerMat);
                spoilerWing.position.set(0, 1.25, 2.0);
                this.mesh.add(spoilerWing);

                // Exhaust Pipes (Nitro Emitters)
                const exhaustGeo = new THREE.CylinderGeometry(0.12, 0.12, 0.4);
                exhaustGeo.rotateX(Math.PI / 2);
                const exhaustMat = new THREE.MeshStandardMaterial({ color: 0x111111, metalness: 0.9 });
                const exL = new THREE.Mesh(exhaustGeo, exhaustMat); exL.position.set(-0.6, 0.4, 2.2);
                const exR = new THREE.Mesh(exhaustGeo, exhaustMat); exR.position.set(0.6, 0.4, 2.2);
                this.mesh.add(exL, exR);

                // Headlights
                const hlGeo = new THREE.BoxGeometry(0.4, 0.18, 0.1);
                const hlMat = new THREE.MeshBasicMaterial({ color: 0xffffff });
                const hlLeft = new THREE.Mesh(hlGeo, hlMat); hlLeft.position.set(-0.75, 0.5, -2.21);
                const hlRight = hlLeft.clone(); hlRight.position.x = 0.75;
                this.mesh.add(hlLeft, hlRight);

                // Wheels Setup
                const wheelGeo = new THREE.CylinderGeometry(0.45, 0.45, 0.4, 16);
                wheelGeo.rotateZ(Math.PI / 2);
                const wheelMat = new THREE.MeshStandardMaterial({ color: 0x111111, roughness: 0.5 });

                const wheelPositions = [
                    new THREE.Vector3(-1.15, 0.45, -1.3),
                    new THREE.Vector3(1.15, 0.45, -1.3),
                    new THREE.Vector3(-1.15, 0.45, 1.3),
                    new THREE.Vector3(1.15, 0.45, 1.3)
                ];

                wheelPositions.forEach((pos) => {
                    const pivot = new THREE.Group();
                    pivot.position.copy(pos);
                    const wMesh = new THREE.Mesh(wheelGeo, wheelMat);
                    wMesh.castShadow = true;
                    pivot.add(wMesh);
                    this.mesh.add(pivot);

                    this.wheelGroup.push(pivot);
                    this.wheelsMesh.push(wMesh);
                });
            }

            update(dt, inputs, canDrive, particleSys, skidMgr, soundEngine) {
                const cfg = this.carConfig;

                // Steering Interp
                let targetSteer = 0;
                if (inputs.left) targetSteer += 1;
                if (inputs.right) targetSteer -= 1;
                this.steerAngle = THREE.MathUtils.lerp(this.steerAngle, targetSteer, dt * 10);

                this.wheelGroup[0].rotation.y = this.steerAngle * 0.45;
                this.wheelGroup[1].rotation.y = this.steerAngle * 0.45;

                // Nitro System Logic
                this.isNitroActive = false;
                let activeMaxSpeed = cfg.maxSpeed;
                let activeAccel = cfg.accel;

                if (inputs.nitro && this.nitroAmount > 0 && canDrive && inputs.forward) {
                    this.isNitroActive = true;
                    this.nitroAmount = Math.max(0, this.nitroAmount - 35 * dt);
                    activeMaxSpeed *= 1.32;
                    activeAccel *= 2.2;

                    // Emit Nitro Flame Particles
                    const exLeftPos = new THREE.Vector3().setFromMatrixPosition(this.mesh.children[3].matrixWorld);
                    const exRightPos = new THREE.Vector3().setFromMatrixPosition(this.mesh.children[4].matrixWorld);
                    particleSys.emitNitroFlame(exLeftPos, this.heading);
                    particleSys.emitNitroFlame(exRightPos, this.heading);
                    soundEngine.setNitro(true);
                } else {
                    soundEngine.setNitro(false);
                    // Slow Nitro Recharge
                    if (this.nitroAmount < 100) {
                        this.nitroAmount = Math.min(100, this.nitroAmount + 12 * dt);
                    }
                }

                // Driving Acceleration
                if (canDrive) {
                    if (inputs.forward) {
                        this.speed += activeAccel * dt;
                    } else if (inputs.backward) {
                        this.speed -= (this.speed > 0 ? 45.0 : cfg.accel * 0.6) * dt;
                    } else {
                        if (this.speed > 0) this.speed = Math.max(0, this.speed - cfg.friction * dt);
                        else if (this.speed < 0) this.speed = Math.min(0, this.speed + cfg.friction * dt);
                    }
                } else {
                    this.speed = 0;
                }

                this.speed = THREE.MathUtils.clamp(this.speed, -20, activeMaxSpeed);

                // Drift / Handbrake Physics
                this.isDrifting = false;
                let effectiveTurnRate = cfg.turnRate;

                if (inputs.handbrake && Math.abs(this.speed) > 12) {
                    this.isDrifting = true;
                    effectiveTurnRate *= cfg.driftFactor;
                    this.speed -= cfg.friction * 0.9 * dt;

                    const rearLeftPos = new THREE.Vector3().setFromMatrixPosition(this.wheelGroup[2].matrixWorld);
                    const rearRightPos = new THREE.Vector3().setFromMatrixPosition(this.wheelGroup[3].matrixWorld);

                    particleSys.emitSmoke(rearLeftPos);
                    particleSys.emitSmoke(rearRightPos);

                    // Add Skid Marks
                    if (this.lastDriftPosLeft && this.lastDriftPosRight) {
                        skidMgr.addMark(this.lastDriftPosLeft, rearLeftPos);
                        skidMgr.addMark(this.lastDriftPosRight, rearRightPos);
                    }
                    this.lastDriftPosLeft = rearLeftPos;
                    this.lastDriftPosRight = rearRightPos;

                    soundEngine.setDrift(true);
                } else {
                    this.lastDriftPosLeft = null;
                    this.lastDriftPosRight = null;
                    soundEngine.setDrift(false);
                }

                // Yaw Angle Adjustment
                if (Math.abs(this.speed) > 0.1) {
                    const dir = this.speed >= 0 ? 1 : -1;
                    this.heading += this.steerAngle * effectiveTurnRate * (this.speed / cfg.maxSpeed) * dir * dt;
                }

                const forwardVector = new THREE.Vector3(0, 0, -1).applyAxisAngle(new THREE.Vector3(0, 1, 0), this.heading);
                this.velocity.copy(forwardVector).multiplyScalar(this.speed);
                this.position.addScaledVector(forwardVector, this.speed * dt);

                this.wheelsMesh.forEach(wm => {
                    wm.rotation.x -= (this.speed * dt) / 0.45;
                });

                this.mesh.position.copy(this.position);
                this.mesh.rotation.y = this.heading;
            }

            getSpeedKMH() {
                return Math.round(Math.abs(this.speed) * 3.6);
            }

            resetToPosition(pos, heading = 0) {
                this.position.copy(pos);
                this.position.y = 0.4;
                this.heading = heading;
                this.speed = 0;
                this.steerAngle = 0;
                this.velocity.set(0, 0, 0);
                this.mesh.position.copy(this.position);
                this.mesh.rotation.y = this.heading;
            }
        }


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Apex Velocity 2: Next Gen - 3D Racing</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Three.js CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@500;700&display=swap');

        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            font-family: 'Rajdhani', sans-serif;
            background: #05070c;
            user-select: none;
        }

        #canvas-container {
            width: 100%;
            height: 100%;
            position: absolute;
            top: 0;
            left: 0;
            z-index: 1;
        }

        .hud-font {
            font-family: 'Orbitron', sans-serif;
        }

        .glass-panel {
            background: rgba(10, 14, 23, 0.85);
            backdrop-filter: blur(14px);
            border: 1px solid rgba(0, 240, 255, 0.25);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.7), inset 0 0 20px rgba(0, 240, 255, 0.08);
        }

        .collision-flash {
            animation: hitFlash 0.3s ease-out;
        }

        @keyframes hitFlash {
            0% { box-shadow: inset 0 0 60px rgba(255, 30, 0, 0.85), 0 0 40px rgba(255, 0, 0, 0.6); }
            100% { box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.7), inset 0 0 20px rgba(0, 240, 255, 0.08); }
        }

        .neon-text-cyan {
            text-shadow: 0 0 10px rgba(0, 240, 255, 0.8), 0 0 22px rgba(0, 240, 255, 0.4);
        }

        .neon-text-orange {
            text-shadow: 0 0 10px rgba(255, 136, 0, 0.8), 0 0 20px rgba(255, 136, 0, 0.4);
        }

        .neon-border-cyan {
            box-shadow: 0 0 15px rgba(0, 240, 255, 0.4);
        }

        .gauge-bar {
            transition: width 0.05s ease-out;
        }

        #countdown-overlay {
            pointer-events: none;
            transition: opacity 0.3s ease;
        }

        #minimap {
            border-radius: 50%;
            border: 2px solid rgba(0, 240, 255, 0.6);
            box-shadow: 0 0 18px rgba(0, 240, 255, 0.4);
            background: rgba(8, 12, 20, 0.88);
        }

        .touch-btn {
            touch-action: manipulation;
            background: rgba(255, 255, 255, 0.12);
            border: 1px solid rgba(255, 255, 255, 0.3);
            backdrop-filter: blur(6px);
        }
        .touch-btn:active {
            background: rgba(0, 240, 255, 0.4);
        }

        .level-card, .car-card {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .level-card:hover:not(.locked), .car-card:hover {
            transform: translateY(-5px) scale(1.02);
            border-color: rgba(0, 240, 255, 0.8);
            box-shadow: 0 10px 30px rgba(0, 240, 255, 0.25);
        }
        .level-card.locked {
            filter: grayscale(0.85) opacity(0.5);
            cursor: not-allowed;
        }
        .car-card.selected {
            border-color: rgba(0, 240, 255, 1);
            background: rgba(0, 240, 255, 0.12);
            box-shadow: 0 0 25px rgba(0, 240, 255, 0.35);
        }

        /* Custom Scrollbars */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(10, 14, 23, 0.6);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(0, 240, 255, 0.4);
            border-radius: 4px;
        }
    </style>
</head>
<body class="text-white overflow-hidden">

    <!-- 3D Canvas Container -->
    <div id="canvas-container"></div>

    <!-- MAIN MENU & LEVEL/VEHICLE SELECT MODAL -->
    <div id="level-select-modal" class="fixed inset-0 z-40 flex items-center justify-center bg-black/90 backdrop-blur-xl p-4 sm:p-6 overflow-y-auto">
        <div class="max-w-6xl w-full flex flex-col items-center my-auto py-6">
            <div class="text-center mb-6">
                <div class="inline-block px-3 py-1 bg-cyan-500/20 border border-cyan-400/40 rounded-full text-xs font-bold text-cyan-300 hud-font tracking-widest mb-2">NEXT GEN SEQUEL</div>
                <h1 class="hud-font text-4xl sm:text-6xl font-black text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-blue-500 to-indigo-500 neon-text-cyan tracking-wider">APEX VELOCITY 2</h1>
                <p class="text-gray-400 text-sm sm:text-base mt-1 font-medium">Select your machine and conquer all 8 grand circuit challenges.</p>
                <div class="mt-3">
                    <button id="reset-scores-btn" class="pointer-events-auto px-4 py-1.5 bg-red-500/10 hover:bg-red-500/30 border border-red-500/40 rounded-full text-xs font-bold text-red-400 hover:text-red-300 hud-font transition tracking-wider">
                        <i class="fa-solid fa-rotate-left mr-1.5"></i>RESET ALL HIGH SCORES
                    </button>
                </div>
            </div>

            <!-- CAR SELECTION HEADER & CARDS -->
            <div class="w-full mb-8">
                <div class="text-xs uppercase tracking-widest text-cyan-400 font-bold mb-3 hud-font flex items-center space-x-2">
                    <i class="fa-solid fa-car-side"></i> <span>Choose Vehicle Class</span>
                </div>
                <div id="car-grid" class="grid grid-cols-1 sm:grid-cols-3 gap-4 w-full">
                    <!-- Dynamic Car Selection Cards -->
                </div>
            </div>

            <!-- LEVEL SELECTION HEADER & GRID -->
            <div class="w-full">
                <div class="text-xs uppercase tracking-widest text-cyan-400 font-bold mb-3 hud-font flex items-center space-x-2">
                    <i class="fa-solid fa-flag-checkered"></i> <span>Select Racing Circuit (8 Stage Campaign)</span>
                </div>
                <div id="level-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 w-full">
                    <!-- Level Cards dynamically populated by JS -->
                </div>
            </div>
        </div>
    </div>

    <!-- PAUSE MENU -->
    <div id="pause-modal" class="hidden fixed inset-0 z-30 flex items-center justify-center bg-black/80 backdrop-blur-md p-4">
        <div class="glass-panel p-8 rounded-3xl max-w-sm w-full border-2 border-cyan-400/50 text-center flex flex-col items-center space-y-4 shadow-2xl">
            <h2 class="hud-font text-3xl font-black text-white tracking-widest">PAUSED</h2>
            <p id="pause-level-name" class="text-cyan-400 font-bold text-sm tracking-wide">Level 1: Suburbia Highway</p>

            <button id="resume-btn" class="pointer-events-auto w-full py-3.5 bg-cyan-500/20 hover:bg-cyan-500/40 border border-cyan-400 rounded-2xl hud-font font-bold text-cyan-300 transition">
                RESUME
            </button>
            <button id="restart-pause-btn" class="pointer-events-auto w-full py-3.5 bg-gray-800 hover:bg-gray-700 border border-gray-600 rounded-2xl hud-font font-bold text-gray-200 transition">
                RESTART LEVEL
            </button>
            <button id="reset-scores-pause-btn" class="pointer-events-auto w-full py-3 bg-red-500/10 hover:bg-red-500/30 border border-red-500/40 rounded-2xl hud-font font-bold text-xs text-red-400 hover:text-red-300 transition">
                RESET ALL HIGH SCORES
            </button>
            <button id="level-select-pause-btn" class="pointer-events-auto w-full py-3.5 bg-red-500/20 hover:bg-red-500/40 border border-red-500/50 rounded-2xl hud-font font-bold text-red-300 transition">
                LEVEL SELECT
            </button>
        </div>
    </div>

    <!-- RESET CONFIRMATION MODAL -->
    <div id="reset-confirm-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/90 backdrop-blur-md p-4">
        <div class="glass-panel p-6 sm:p-8 rounded-3xl max-w-md w-full border-2 border-red-500/60 text-center flex flex-col items-center shadow-2xl">
            <div class="w-14 h-14 bg-red-500/20 rounded-full flex items-center justify-center mb-3 text-red-400 text-2xl border border-red-500/40">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <h3 class="hud-font text-2xl font-black text-white tracking-wide">RESET SAVE DATA?</h3>
            <p class="text-gray-300 text-sm mt-2 leading-relaxed">Are you sure you want to reset all unlocked campaign levels and best lap time records?</p>

            <div class="flex space-x-3 w-full mt-6">
                <button id="cancel-reset-btn" class="pointer-events-auto w-1/2 py-3.5 bg-gray-800 hover:bg-gray-700 border border-gray-600 rounded-2xl hud-font font-bold text-xs tracking-wider text-gray-200 transition">
                    CANCEL
                </button>
                <button id="confirm-reset-btn" class="pointer-events-auto w-1/2 py-3.5 bg-red-600 hover:bg-red-500 rounded-2xl hud-font font-bold text-xs tracking-wider text-white shadow-lg shadow-red-600/40 transition">
                    YES, RESET ALL
                </button>
            </div>
        </div>
    </div>

    <!-- MAIN HUD INTERFACE -->
    <div id="hud" class="absolute inset-0 z-10 pointer-events-none flex flex-col justify-between p-4 sm:p-6 transition-all duration-75">

        <!-- Top Header: Times, Laps & Level Info -->
        <div class="flex justify-between items-start w-full">
            <div class="glass-panel rounded-2xl p-4 min-w-[160px] sm:min-w-[200px]">
                <div class="flex justify-between items-center">
                    <div class="text-xs uppercase tracking-widest text-gray-400 font-bold">Lap Position</div>
                    <button id="pause-btn" class="pointer-events-auto px-2.5 py-1 bg-cyan-500/20 hover:bg-cyan-500/40 border border-cyan-400/40 rounded text-[10px] font-bold text-cyan-300">
                        ESC
                    </button>
                </div>
                <div class="flex items-baseline space-x-1 mt-1">
                    <span id="current-lap" class="hud-font text-3xl sm:text-4xl font-extrabold text-cyan-400 neon-text-cyan">1</span>
                    <span class="hud-font text-lg text-gray-500">/</span>
                    <span id="total-laps" class="hud-font text-xl text-gray-400">3</span>
                </div>
                <div id="checkpoint-tag" class="text-xs text-cyan-300 mt-1 font-semibold">Checkpoint 0/4</div>
            </div>

            <!-- Notifications / Warnings -->
            <div class="text-center">
                <div id="notification-box" class="hidden glass-panel px-6 py-2 rounded-full border-cyan-400 animate-bounce">
                    <span id="notification-text" class="hud-font text-lg sm:text-xl font-bold tracking-wider text-yellow-400 neon-text-orange">WRONG WAY!</span>
                </div>
            </div>

            <div class="glass-panel rounded-2xl p-4 min-w-[180px] sm:min-w-[220px] text-right">
                <div class="text-xs uppercase tracking-widest text-gray-400 font-bold">Current Time</div>
                <div id="lap-time" class="hud-font text-2xl sm:text-3xl font-bold text-white tracking-wider">00:00.00</div>
                <div class="flex justify-end items-center space-x-2 mt-2 text-xs text-gray-400">
                    <span>BEST:</span>
                    <span id="best-time" class="hud-font text-sm text-yellow-400 font-bold">--:--.--</span>
                </div>
            </div>
        </div>

        <!-- Center Overlay: Countdown & Start -->
        <div id="countdown-overlay" class="absolute inset-0 flex items-center justify-center flex-col">
            <div id="countdown-text" class="hud-font text-7xl sm:text-9xl font-black text-cyan-400 neon-text-cyan">3</div>
            <div id="countdown-subtext" class="hud-font text-sm sm:text-base text-gray-300 mt-2 uppercase tracking-widest bg-black/50 px-4 py-1 rounded-full border border-cyan-500/30">Get Ready</div>
        </div>

        <!-- Bottom Header: Controls Info, Speedometer, Nitro Gauge & Mini-map -->
        <div class="flex justify-between items-end w-full">
            <div class="hidden md:flex flex-col space-y-2 glass-panel p-3.5 rounded-xl text-xs text-gray-300">
                <div class="flex items-center space-x-2"><kbd class="px-2 py-0.5 bg-gray-800 rounded border border-gray-600 text-cyan-400 font-bold">W A S D / Arrows</kbd> <span>Drive / Steer</span></div>
                <div class="flex items-center space-x-2"><kbd class="px-2 py-0.5 bg-gray-800 rounded border border-gray-600 text-cyan-400 font-bold">SHIFT</kbd> <span class="text-cyan-300 font-bold">Nitro Boost</span></div>
                <div class="flex items-center space-x-2"><kbd class="px-2 py-0.5 bg-gray-800 rounded border border-gray-600 text-cyan-400 font-bold">SPACE</kbd> <span>Handbrake / Drift</span></div>
                <div class="flex items-center space-x-2"><kbd class="px-2 py-0.5 bg-gray-800 rounded border border-gray-600 text-cyan-400 font-bold">R / C</kbd> <span>Reset / Camera</span></div>
            </div>

            <!-- Speedometer & Nitro Panel -->
            <div class="glass-panel p-4 sm:p-5 rounded-3xl flex flex-col items-center min-w-[240px] sm:min-w-[300px]">
                <div class="flex items-baseline space-x-2">
                    <span id="speed-display" class="hud-font text-5xl sm:text-6xl font-black text-white tracking-tighter">0</span>
                    <span class="hud-font text-sm sm:text-base text-cyan-400 font-bold">KM/H</span>
                </div>
                
                <!-- RPM Gauge -->
                <div class="w-full bg-gray-900 h-2.5 rounded-full mt-2 overflow-hidden p-0.5 border border-gray-700">
                    <div id="rpm-bar" class="gauge-bar h-full bg-gradient-to-r from-cyan-500 via-blue-500 to-red-500 rounded-full w-0"></div>
                </div>

                <!-- Nitro Gauge Bar -->
                <div class="w-full mt-3">
                    <div class="flex justify-between text-[10px] font-bold text-cyan-400 hud-font mb-1">
                        <span><i class="fa-solid fa-bolt text-yellow-400"></i> NITRO BOOST</span>
                        <span id="nitro-percent">100%</span>
                    </div>
                    <div class="w-full bg-gray-900 h-3 rounded-full overflow-hidden p-0.5 border border-cyan-500/40">
                        <div id="nitro-bar" class="gauge-bar h-full bg-gradient-to-r from-cyan-400 via-blue-400 to-indigo-500 rounded-full w-full"></div>
                    </div>
                </div>
            </div>

            <!-- Mini-map -->
            <div class="relative flex items-center justify-center">
                <canvas id="minimap" width="140" height="140"></canvas>
            </div>
        </div>

    </div>

    <!-- TOUCH CONTROLS (MOBILE) -->
    <div id="touch-controls" class="absolute inset-0 z-20 pointer-events-none hidden flex-col justify-between p-6">
        <div class="flex justify-between w-full mt-auto mb-2 pointer-events-auto">
            <div class="flex space-x-2">
                <button id="btn-left" class="touch-btn w-14 h-14 rounded-2xl text-xl flex items-center justify-center text-white"><i class="fa-solid font-bold fa-chevron-left"></i></button>
                <button id="btn-right" class="touch-btn w-14 h-14 rounded-2xl text-xl flex items-center justify-center text-white"><i class="fa-solid font-bold fa-chevron-right"></i></button>
            </div>
            <div class="flex space-x-2 items-end">
                <button id="btn-nitro" class="touch-btn w-14 h-14 rounded-2xl text-xs font-bold flex flex-col items-center justify-center text-yellow-300 border-yellow-400/50"><i class="fa-solid fa-bolt mb-1 text-base"></i>NITRO</button>
                <button id="btn-brake" class="touch-btn w-14 h-14 rounded-2xl text-xs font-bold flex items-center justify-center text-red-400">BRAKE</button>
                <button id="btn-gas" class="touch-btn w-16 h-16 rounded-2xl text-sm font-bold flex items-center justify-center text-cyan-400 bg-cyan-500/20 border-cyan-400">GAS</button>
            </div>
        </div>
    </div>

    <!-- FINISH MODAL -->
    <div id="finish-modal" class="hidden fixed inset-0 z-30 flex items-center justify-center bg-black/85 backdrop-blur-md p-4">
        <div class="glass-panel p-8 rounded-3xl max-w-md w-full border-2 border-cyan-400 text-center flex flex-col items-center shadow-2xl">
            <div class="w-16 h-16 bg-cyan-500/20 rounded-full flex items-center justify-center mb-4 text-cyan-400 text-3xl neon-border-cyan">
                <i class="fa-solid fa-trophy"></i>
            </div>
            <h2 class="hud-font text-3xl font-black text-white tracking-wide">RACE COMPLETED!</h2>
            <p class="text-gray-400 text-sm mt-1">Stunning performance on the circuit.</p>

            <div class="w-full bg-gray-900/90 rounded-2xl p-4 my-6 space-y-3 border border-gray-800">
                <div class="flex justify-between text-sm">
                    <span class="text-gray-400">Total Race Time</span>
                    <span id="final-total-time" class="hud-font font-bold text-white">00:00.00</span>
                </div>
                <div class="flex justify-between text-sm">
                    <span class="text-gray-400">Best Lap</span>
                    <span id="final-best-lap" class="hud-font font-bold text-yellow-400">00:00.00</span>
                </div>
                <div class="flex justify-between text-sm">
                    <span class="text-gray-400">Top Speed</span>
                    <span id="final-top-speed" class="hud-font font-bold text-cyan-400">0 KM/H</span>
                </div>
            </div>

            <div class="flex space-x-3 w-full">
                <button id="level-select-btn" class="pointer-events-auto w-1/2 py-4 bg-gray-800 hover:bg-gray-700 border border-gray-600 rounded-2xl hud-font font-bold text-sm tracking-wider text-gray-200 transition">
                    LEVEL SELECT
                </button>
                <button id="restart-btn" class="pointer-events-auto w-1/2 py-4 bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 rounded-2xl hud-font font-bold text-sm tracking-wider text-black shadow-lg shadow-cyan-500/30 transition transform active:scale-95">
                    RETRY
                </button>
            </div>
        </div>
    </div>


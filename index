            drawMinimap(curve, carPos, carHeading = 0) {
                if (!curve || !carPos) return;

                const ctx = this.minimapCtx;
                const w = this.minimapCanvas.width;
                const h = this.minimapCanvas.height;

                ctx.clearRect(0, 0, w, h);

                const points = curve.getSpacedPoints(120);
                if (!points || points.length === 0) return;

                let minX = Infinity, maxX = -Infinity, minZ = Infinity, maxZ = -Infinity;
                points.forEach(pt => {
                    if (pt.x < minX) minX = pt.x;
                    if (pt.x > maxX) maxX = pt.x;
                    if (pt.z < minZ) minZ = pt.z;
                    if (pt.z > maxZ) maxZ = pt.z;
                });

                const trackW = Math.max(maxX - minX, 60);
                const trackH = Math.max(maxZ - minZ, 60);
                const padding = 20;

                const scaleX = (w - padding * 2) / trackW;
                const scaleZ = (h - padding * 2) / trackH;
                const scale = Math.min(scaleX, scaleZ);

                const mapX = (x) => w / 2 + (x - (minX + maxX) / 2) * scale;
                const mapY = (z) => h / 2 + (z - (minZ + maxZ) / 2) * scale;

                // Draw Track Spline Path
                ctx.beginPath();
                ctx.lineWidth = 6;
                ctx.lineCap = 'round';
                ctx.lineJoin = 'round';
                ctx.strokeStyle = 'rgba(0, 240, 255, 0.55)';

                points.forEach((pt, idx) => {
                    const px = mapX(pt.x);
                    const py = mapY(pt.z);
                    if (idx === 0) ctx.moveTo(px, py);
                    else ctx.lineTo(px, py);
                });
                ctx.closePath();
                ctx.stroke();

                // Draw Start/Finish Dot
                const startX = mapX(points[0].x);
                const startY = mapY(points[0].z);
                ctx.fillStyle = '#ffffff';
                ctx.beginPath();
                ctx.arc(startX, startY, 4, 0, Math.PI * 2);
                ctx.fill();

                // Draw Player Car Position & Heading Arrow
                const playerX = mapX(carPos.x);
                const playerY = mapY(carPos.z);

                ctx.save();
                ctx.translate(playerX, playerY);

                // Car Dot Marker
                ctx.fillStyle = '#ff8800';
                ctx.shadowColor = '#ff8800';
                ctx.shadowBlur = 10;
                ctx.beginPath();
                ctx.arc(0, 0, 5, 0, Math.PI * 2);
                ctx.fill();

                // Direction Indicator
                const dirX = -Math.sin(carHeading) * 8;
                const dirY = -Math.cos(carHeading) * 8;

                ctx.strokeStyle = '#ffff00';
                ctx.lineWidth = 2.5;
                ctx.beginPath();
                ctx.moveTo(0, 0);
                ctx.lineTo(dirX, dirY);
                ctx.stroke();

                ctx.restore();
            }

            formatTime(ms) {
                const sec = Math.floor(ms / 1000);
                const min = Math.floor(sec / 60);
                const remainSec = sec % 60;
                const millis = Math.floor((ms % 1000) / 10);
                return `${min.toString().padStart(2, '0')}:${remainSec.toString().padStart(2, '0')}.${millis.toString().padStart(2, '0')}`;
            }
        }

        // MAIN GAME ENGINE SEQUEL
        class GameEngine {
            constructor() {
                this.container = document.getElementById('canvas-container');

                this.scene = new THREE.Scene();
                this.camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 4000);
                this.cameraMode = 0;
                this.screenShake = 0;

                this.renderer = new THREE.WebGLRenderer({ antialias: true });
                this.renderer.setSize(window.innerWidth, window.innerHeight);
                this.renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
                this.renderer.shadowMap.enabled = true;
                this.container.appendChild(this.renderer.domElement);

                this.input = new InputHandler();
                this.hud = new HUDManager();
                this.sound = new SoundEngine();
                this.particleSys = new ParticleSystem(this.scene);
                this.skidMgr = new SkidMarkManager(this.scene);

                this.trackBuilder = new TrackBuilder(this.scene);
                this.car = new SportsCar(this.scene);

                this.setupLighting();

                // Multi-Level Progression Storage (Sequel LocalStorage Keys)
                this.unlockedLevels = JSON.parse(localStorage.getItem('apex2_unlocked_levels')) || [1];
                this.bestTimes = JSON.parse(localStorage.getItem('apex2_best_times')) || {};

                this.selectedCarConfig = CAR_CONFIGS[0];
                this.currentLevelConfig = LEVEL_CONFIGS[0];
                this.isRacing = false;
                this.isPaused = false;
                this.totalLaps = 3;
                this.currentLap = 1;
                this.currentCPIndex = 0;
                this.lapStartTime = 0;
                this.totalStartTime = 0;
                this.bestLapTime = Infinity;
                this.topSpeedAchieved = 0;

                // Event Bindings
                this.input.onResetPress = () => this.resetCarToTrack();
                this.input.onCameraPress = () => this.toggleCamera();
                this.input.onPausePress = () => this.togglePause();

                document.getElementById('pause-btn').addEventListener('click', () => this.togglePause());
                document.getElementById('resume-btn').addEventListener('click', () => this.togglePause());
                document.getElementById('restart-pause-btn').addEventListener('click', () => { this.hidePause(); this.startRaceSequence(); });
                document.getElementById('level-select-pause-btn').addEventListener('click', () => { this.hidePause(); this.openLevelSelect(); });

                // Reset High Scores Listeners & Modal Trigger
                const resetConfirmModal = document.getElementById('reset-confirm-modal');
                const promptReset = () => resetConfirmModal.classList.remove('hidden');
                const closeReset = () => resetConfirmModal.classList.add('hidden');

                document.getElementById('reset-scores-btn').addEventListener('click', promptReset);
                document.getElementById('reset-scores-pause-btn').addEventListener('click', promptReset);
                document.getElementById('cancel-reset-btn').addEventListener('click', closeReset);
                document.getElementById('confirm-reset-btn').addEventListener('click', () => {
                    closeReset();
                    this.resetAllHighScores();
                });

                document.getElementById('restart-btn').addEventListener('click', () => this.startRaceSequence());
                document.getElementById('level-select-btn').addEventListener('click', () => this.openLevelSelect());

                window.addEventListener('click', () => this.sound.init(), { once: true });
                window.addEventListener('keydown', () => this.sound.init(), { once: true });
                window.addEventListener('resize', () => this.onWindowResize());

                this.init();
            }

            resetAllHighScores() {
                localStorage.removeItem('apex2_unlocked_levels');
                localStorage.removeItem('apex2_best_times');
                localStorage.removeItem('apex_unlocked_levels');
                localStorage.removeItem('apex_best_times');

                this.unlockedLevels = [1];
                this.bestTimes = {};
                this.bestLapTime = Infinity;

                this.hud.showNotification("SAVE DATA RESET SUCCESSFULLY", 2500);

                if (!this.hud.pauseModal.classList.contains('hidden')) {
                    this.hidePause();
                }
                this.openLevelSelect();
            }

            setupLighting() {
                this.ambient = new THREE.AmbientLight(0xffffff, 0.75);
                this.scene.add(this.ambient);

                this.sun = new THREE.DirectionalLight(0xffffff, 1.2);
                this.sun.position.set(100, 160, 60);
                this.sun.castShadow = true;
                this.sun.shadow.mapSize.width = 1024;
                this.sun.shadow.mapSize.height = 1024;
                this.scene.add(this.sun);
            }

            init() {
                this.clock = new THREE.Clock();
                this.car.setCarConfig(this.selectedCarConfig);
                this.openLevelSelect();
                this.animate();
            }

            openLevelSelect() {
                this.isRacing = false;
                this.hud.hideFinishScreen();
                this.hud.hidePauseMenu();
                
                const updateCarSelectionUI = () => {
                    this.hud.renderCarSelect(this.selectedCarConfig.id, (car) => {
                        this.selectedCarConfig = car;
                        this.car.setCarConfig(car);
                        updateCarSelectionUI();
                    });
                };
                updateCarSelectionUI();

                this.hud.renderLevelSelect(this.unlockedLevels, this.bestTimes, (lvl) => this.selectLevel(lvl));
            }

            selectLevel(lvlConfig) {
                this.currentLevelConfig = lvlConfig;
                this.totalLaps = lvlConfig.laps || 3;
                this.hud.hideLevelSelect();

                // Environment Theme & Weather
                this.scene.background = new THREE.Color(lvlConfig.skyColor);
                this.scene.fog = new THREE.FogExp2(lvlConfig.fogColor, lvlConfig.fogDensity);

                this.trackCurve = this.trackBuilder.build(lvlConfig);
                this.bestLapTime = this.bestTimes[lvlConfig.id] || Infinity;
                this.skidMgr.clear();

                this.resetCarToTrack();
                this.particleSys.setupWeather(lvlConfig.weather, this.car.position);

                this.startRaceSequence();
            }

            togglePause() {
                if (this.hud.levelSelectModal.classList.contains('hidden') && this.hud.finishModal.classList.contains('hidden')) {
                    this.isPaused = !this.isPaused;
                    if (this.isPaused) {
                        this.hud.showPauseMenu(this.currentLevelConfig.name);
                    } else {
                        this.hud.hidePauseMenu();
                    }
                }
            }

            hidePause() {
                this.isPaused = false;
                this.hud.hidePauseMenu();
            }

            handleCollisions() {
                const carPos = this.car.position;
                const carRadius = this.car.radius;

                for (let b of this.trackBuilder.barriers) {
                    const seg = b.p2.clone().sub(b.p1);
                    const lenSq = seg.lengthSq();
                    if (lenSq === 0) continue;

                    let t = carPos.clone().sub(b.p1).dot(seg) / lenSq;
                    t = Math.max(0, Math.min(1, t));

                    const closestPt = b.p1.clone().add(seg.clone().multiplyScalar(t));
                    const distVec = carPos.clone().sub(closestPt);
                    distVec.y = 0;
                    const dist = distVec.length();

                    if (dist < carRadius) {
                        let normal = distVec.clone().normalize();
                        if (dist === 0) normal = b.normal.clone();

                        const overlap = carRadius - dist;
                        carPos.add(normal.clone().multiplyScalar(overlap));
                        this.car.mesh.position.copy(carPos);

                        const currentSpeed = Math.abs(this.car.speed);
                        if (currentSpeed > 3) {
                            this.car.speed = -this.car.speed * 0.45;

                            const impactForce = Math.min(currentSpeed / 40, 1.5);
                            this.particleSys.emitSparks(closestPt.clone().setY(0.8), Math.floor(10 + impactForce * 15));
                            this.sound.playImpact(impactForce);
                            this.screenShake = Math.max(this.screenShake, impactForce * 0.8);
                            this.hud.triggerCollisionFlash();

                            this.car.heading += (Math.random() - 0.5) * 0.25;
                        }
                    }
                }
            }

            startRaceSequence() {
                this.hud.hideFinishScreen();
                this.isRacing = false;
                this.isPaused = false;
                this.currentLap = 1;
                this.currentCPIndex = 0;
                this.topSpeedAchieved = 0;
                this.resetCarToTrack();

                let count = 3;
                this.hud.showCountdown(count);

                const interval = setInterval(() => {
                    count--;
                    if (count > 0) {
                        this.hud.showCountdown(count);
                    } else if (count === 0) {
                        this.hud.showCountdown(0);
                        this.isRacing = true;
                        this.lapStartTime = performance.now();
                        this.totalStartTime = performance.now();
                        clearInterval(interval);
                    }
                }, 1000);
            }

            resetCarToTrack() {
                const startPt = this.trackBuilder.config.waypoints[0];
                const tangent = this.trackCurve.getTangentAt(0);
                const angle = Math.atan2(-tangent.x, -tangent.z);
                this.car.resetToPosition(new THREE.Vector3(startPt.x, startPt.y + 0.4, startPt.z), angle);
                this.hud.showNotification("CAR RESET TO TRACK", 1500);
            }

            toggleCamera() {
                this.cameraMode = (this.cameraMode + 1) % 2;
                this.hud.showNotification(this.cameraMode === 0 ? "CAMERA: CHASE" : "CAMERA: HOOD", 1500);
            }

            checkCheckpoints() {
                if (!this.isRacing || this.isPaused) return;

                const carPos = this.car.mesh.position;
                const cps = this.trackBuilder.checkpoints;
                const targetCP = cps[this.currentCPIndex];

                if (carPos.distanceTo(targetCP.position) < targetCP.radius) {
                    this.currentCPIndex++;

                    if (this.currentCPIndex >= cps.length) {
                        const now = performance.now();
                        const lapTime = now - this.lapStartTime;

                        if (lapTime < this.bestLapTime) {
                            this.bestLapTime = lapTime;
                            this.bestTimes[this.currentLevelConfig.id] = lapTime;
                            localStorage.setItem('apex2_best_times', JSON.stringify(this.bestTimes));
                            this.hud.showNotification("NEW BEST LAP!", 2500);
                        }

                        if (this.currentLap >= this.totalLaps) {
                            this.isRacing = false;

                            // Unlock Next Campaign Level
                            const nextLevelId = this.currentLevelConfig.id + 1;
                            if (nextLevelId <= LEVEL_CONFIGS.length && !this.unlockedLevels.includes(nextLevelId)) {
                                this.unlockedLevels.push(nextLevelId);
                                localStorage.setItem('apex2_unlocked_levels', JSON.stringify(this.unlockedLevels));
                            }

                            this.hud.showFinishScreen(now - this.totalStartTime, this.bestLapTime, this.topSpeedAchieved);
                        } else {
                            this.currentLap++;
                            this.currentCPIndex = 0;
                            this.lapStartTime = now;
                            this.hud.showNotification(`LAP ${this.currentLap}!`, 2000);
                        }
                    }
                }
            }

            updateCamera(speed) {
                const carMesh = this.car.mesh;

                if (this.cameraMode === 0) {
                    const offset = new THREE.Vector3(0, 3.6, 8.5).applyAxisAngle(new THREE.Vector3(0, 1, 0), this.car.heading);
                    const targetCamPos = carMesh.position.clone().add(offset);

                    if (this.screenShake > 0.01) {
                        targetCamPos.x += (Math.random() - 0.5) * this.screenShake;
                        targetCamPos.y += (Math.random() - 0.5) * this.screenShake;
                        targetCamPos.z += (Math.random() - 0.5) * this.screenShake;
                        this.screenShake *= 0.88;
                    }

                    this.camera.position.lerp(targetCamPos, 0.12);

                    const targetLook = carMesh.position.clone().add(new THREE.Vector3(0, 1.2, 0));
                    this.camera.lookAt(targetLook);

                    // Dynamic FOV Boost Kick
                    const nitroFOV = this.car.isNitroActive ? 12 : 0;
                    this.camera.fov = THREE.MathUtils.lerp(this.camera.fov, 60 + Math.min(speed / 4, 25) + nitroFOV, 0.08);
                } else {
                    const offset = new THREE.Vector3(0, 1.1, -0.4).applyAxisAngle(new THREE.Vector3(0, 1, 0), this.car.heading);
                    const camPos = carMesh.position.clone().add(offset);

                    if (this.screenShake > 0.01) {
                        camPos.x += (Math.random() - 0.5) * this.screenShake * 0.5;
                        camPos.y += (Math.random() - 0.5) * this.screenShake * 0.5;
                        this.screenShake *= 0.88;
                    }

                    this.camera.position.copy(camPos);
                    const forward = new THREE.Vector3(0, 0, -10).applyAxisAngle(new THREE.Vector3(0, 1, 0), this.car.heading);
                    this.camera.lookAt(this.camera.position.clone().add(forward));
                    this.camera.fov = 75;
                }
                this.camera.updateProjectionMatrix();
            }

            animate() {
                requestAnimationFrame(() => this.animate());

                const dt = Math.min(this.clock.getDelta(), 0.1);
                this.dt = dt;

                if (!this.isPaused) {
                    this.car.update(dt, this.input.keys, this.isRacing, this.particleSys, this.skidMgr, this.sound);
                    this.handleCollisions();

                    const speed = this.car.getSpeedKMH();
                    if (speed > this.topSpeedAchieved) this.topSpeedAchieved = speed;

                    this.sound.updateEngine(speed / (this.car.carConfig.maxSpeed * 3.6), this.isRacing);
                    this.particleSys.update(dt, this.car.position);
                    this.checkCheckpoints();
                    this.updateCamera(speed);

                    this.hud.updateSpeed(speed, this.car.nitroAmount);
                    if (this.isRacing) {
                        this.hud.updateTimers(performance.now() - this.lapStartTime, this.bestLapTime);
                    }
                    this.hud.updateLapInfo(this.currentLap, this.totalLaps, this.currentCPIndex, this.trackBuilder.checkpoints.length);
                    this.hud.drawMinimap(this.trackCurve, this.car.mesh.position, this.car.heading);
                }

                this.renderer.render(this.scene, this.camera);
            }

            onWindowResize() {
                this.camera.aspect = window.innerWidth / window.innerHeight;
                this.camera.updateProjectionMatrix();
                this.renderer.setSize(window.innerWidth, window.innerHeight);
            }
        }

        // Initialize Sequel Engine when Window loads
        window.addEventListener('load', () => {
            if (typeof THREE !== 'undefined') {
                new GameEngine();
            } else {
                console.error("Three.js failed to load.");
            }
        });
    </script>
</body>
